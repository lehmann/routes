[Unit]
Description=Routes — Next.js Frontend Application (container)
After=docker.service routes-otp.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/routes
# Roda só o serviço "app" do compose; o Node vive dentro da imagem
ExecStart=/usr/bin/docker compose up app
ExecStop=/usr/bin/docker compose stop app
Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=routes-app

[Install]
WantedBy=multi-user.target
