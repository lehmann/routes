[Unit]
Description=Routes — VBB GTFS Update Timer (Mondays at 03:00)

[Timer]
# Run every Monday at 3 AM Berlin time (VBB updates twice a week)
OnCalendar=Mon 03:00:00
# If the server was off at the scheduled time, run on next boot
Persistent=true
Unit=routes-gtfs.service

[Install]
WantedBy=timers.target
